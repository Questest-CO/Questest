@page "/questionnaire-fill/{FilledId:int}"


@inject QuestionnaireService QuestionnaireService
@inject QuestionService QuestionService
@inject OptionsService OptionsService
@inject QuestionnaireFilledService QuestionnaireFilledService
@inject QuestionAnswerService QuestionAnswerService


@inject SessionStorage sessionStorage
@using PPZKwestionariusze.Services
@using PPZKwestionariusze.Models
@using PPZKwestionariusze.StateStore
@using PPZKwestionariusze.Components

<div class="homepage-container">

    @if (isLoading)
    {
        <div class="preloader"></div>
    }
    else if (nonexistent)
    {
        <div class="info-box error">
            <i class="fa-solid fa-ban"></i>
            <span>Ta odpowiedź nie istnieje.</span>
        </div>
    }
    else if (block)
    {
        <div class="info-box">
            <i class="fa-solid fa-ban"></i>
            <span>Tylko właściciel kwestionariusza może wyświetlić odpowiedzi.</span>
        </div>
    }
    else
    {
        <h3 class="homepage-heading">Wypełniony kwestionariusz</h3>

        @if (filled == null)
        {
            <div class="preloader"></div>
        }
        else
        {
            <div class="filled-details">
                <p><strong>Kwestionariusz:</strong> @questionnaire.Title</p>
                <p><strong>Użytkownik:</strong> @filled.FilledByUsername</p>
                <p><strong>Data wypełnienia:</strong> @filled.DateFilled.ToString("yyyy-MM-dd HH:mm")</p>
            </div>

            <h4 class="section-heading">Odpowiedzi:</h4>

            @if (questions.Any())
            {
                <div class="questions-container">
                    @foreach (var q in questions)
                    {
                        <div class="question-block">
                            <p class="question-content"><strong>@q.Content</strong></p>

                            @if (answersOpenDict.TryGetValue(q.Id, out var openAnswer))
                            {
                                <p class="open-answer"><em>@openAnswer.Answer</em></p>
                            }
                            else if (optionsByQuestion.TryGetValue(q.Id, out var opts))
                            {
                                <ul class="options-list">
                                    @foreach (var opt in opts)
                                    {
                                        bool isChosen = answersClosed.Any(a => a.OptionId == opt.Id && a.IsChosen == "T");
                                        <li class="option-item @(isChosen ? "chosen-option" : "")">
                                            @opt.Content @(opt.IsCorrect == "T" ? "(Poprawna)" : "")
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="no-answer">Brak odpowiedzi</p>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p>Brak pytań.</p>
            }
        }
    }
</div>

@code {
    [Parameter]
    public int? FilledId { get; set; }

    private QuestionnaireFilled filled;

    private Questionnaire questionnaire;
    private List<Question> questions = new();
    private List<QuestionAnswer> answersClosed = new();
    private Dictionary<int, QuestionAnswerOpen> answersOpenDict = new();
    private Dictionary<int, List<Option>> optionsByQuestion = new();

    String error_mess = "";
    UserStorageModel? usm;
    String message;
    bool nonexistent = false;
    bool block = false;
    bool isLoading = true;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (firstRender)
        {
            usm = await sessionStorage.GetUserAsync();

            if (usm == null)
            {
                block = true;
                isLoading = false;
                StateHasChanged();
                return;
            }
            else
            {
                if (questionnaire != null)
                {
                    if (questionnaire.CreatedBy != usm.Id)
                    {
                        block = true;
                        isLoading = false;
                        StateHasChanged();
                        return;
                    }
                }
                block = false;
            }
            isLoading = false;
            StateHasChanged();
        }



    }



    protected override async Task OnInitializedAsync()
    {
        if (true)
        {
            filled = await QuestionnaireFilledService.GetQuestionnaireFilledByIDAsync(FilledId.Value);

            if (filled == null)
            {
                nonexistent = true;
                return;
            }


            questionnaire = await QuestionnaireService.GetQuestionnaireByIDAsync(filled.QuestionnaireId);

            if (usm != null)
            {
                if(questionnaire.CreatedBy != usm.Id)
                {
                    block = true;
                    return;
                }
            }

            answersClosed = await QuestionAnswerService.GetAnswersForQuestionnaireFilled(FilledId.Value);
            var answersOpen = await QuestionAnswerService.GetAnswersOpenForQuestionnaireFilled(FilledId.Value);

            // Map otwartych odpowiedzi po QuestionId
            answersOpenDict = answersOpen.ToDictionary(a => a.QuestionId, a => a);

            // Pobierz pytania powiązane z tym wypełnieniem
            questions = await QuestionService.GetQuestionsForQuestionnaire(questionnaire.Id);

            // Pobierz opcje dla każdego pytania (tylko jeśli są odpowiedzi zamknięte)
            foreach (var question in questions)
            {
                var opts = await OptionsService.GetOptionsForQuestion(question.Id);
                optionsByQuestion[question.Id] = opts;
            }
        }
    }

}
