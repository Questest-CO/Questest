﻿@using PPZKwestionariusze.Models;

<div class="question-box p-2 border rounded mb-3">
    <label class="search-label">Treść pytania:</label>
    <input class="searchbox" @bind="Question.Content" />

    <label class="search-label">Odpowiedzi:</label>
    <br />
    @foreach (Option option in Question.Options)
    {
        <OptionsComponent Results="Results" CategoryId="CategoryId" Option="option" OnRemove="() => RemoveOption(option)" />
    }

    <div class="space-between-buttons">
        <button class="btn1" @onclick="AddOption">Dodaj odpowiedź</button>
        <button class="btn2" @onclick="OnRemove">Usuń pytanie</button>
    </div>
</div>

@code {
    [Parameter] public Question Question { get; set; } = new Question { Id = -1 };
    [Parameter] public int CategoryId { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public List<QuizResult> Results { get; set; } = new();


    private void AddOption()
    {
        Question.Options.Add(new Option { Id = -1 });
    }

    private void RemoveOption(Option option)
    {
        Question.Options.Remove(option);
    }
}