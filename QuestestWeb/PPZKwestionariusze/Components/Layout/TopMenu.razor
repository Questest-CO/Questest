@using PPZKwestionariusze.Models
@using PPZKwestionariusze.StateStore
@inject SessionStorage sessionStorage
@inject NavigationManager nav

<nav class="nav">
    <div class="nav-left">
        <img src="images/logo.png" class="nav-logo" />
    </div>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />

    <label for="nav-toggle" class="nav-toggle-btn">
        <span></span>
        <span></span>
        <span></span>
    </label>

    <div class="nav-menu">
        <NavLink href="/" Match="NavLinkMatch.All" class="nav-item">
            <i class="icon bi-house"></i> Strona Główna
        </NavLink>

        <div class="nav-dropdown">
            <button class="nav-item">
                <i class="icon bi-list"></i> Kwestionariusze
            </button>

            <div class="nav-dropdown-menu">
                <NavLink href="/add-questionnaire" class="dropdown-link">Twórz</NavLink>
                <NavLink href="/questionnaires" class="dropdown-link">Przeglądaj</NavLink>
            </div>
        </div>

        <NavLink href="/users" class="nav-item">
            <i class="icon bi-people"></i> Użytkownicy
        </NavLink>

        <div class="nav-right">
            @if (usm is null)
            {
                <NavLink href="/login" class="nav-item small-btn">Logowanie</NavLink>
                <NavLink href="/register" class="nav-item small-btn">Rejestracja</NavLink>
            }
            else
            {
                <NavLink href="/usersettings" class="icon-btn"><img src="images/sett.png" /></NavLink>
                <NavLink href="/inbox" class="icon-btn"><img src="images/noti.png" /></NavLink>
                <NavLink href="/profile" class="icon-btn"><img src="images/user.png" /></NavLink>
            }
        </div>
    </div>
</nav>

@code {
    private UserStorageModel? usm;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            usm = await sessionStorage.GetUserAsync();
            StateHasChanged();
        }
    }
}
