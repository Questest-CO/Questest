@using PPZKwestionariusze.Models;
@using PPZKwestionariusze.StateStore;
@inject SessionStorage sessionStorage
@inject NavigationManager nav;

<nav class="top-nav">
	<div class="menu-logo">
		<img src="../images/logo.png" />
	</div>

	<div class="menu-items">
		<button class="menu-button">
			<span class="menu-text">
				<NavLink href="/" Match="NavLinkMatch.All">Strona Główna</NavLink>
			</span>
		</button>

		<button class="menu-button">
			<span class="menu-text">
				<NavLink Match="NavLinkMatch.All">Kwestionariusze</NavLink>
				<div class="menu-dropdown">
					<NavLink href="/add-questionnaire">Twórz</NavLink>
					<NavLink href="/questionnaires">Przeglądaj</NavLink>
				</div>
			</span>
		</button>

		<button class="menu-button">
			<span class="menu-text">
				<NavLink href="/users">Użytkownicy</NavLink>
			</span>
		</button>

		<div class="menu-user">
			@if (usm is null)
			{
				<button class="menu-button">
					<span class="menu-text">
						<NavLink href="/login">Zaloguj się</NavLink>
					</span>
				</button>

				<button class="menu-button">
					<span class="menu-text">
						<NavLink href="/register">Zarejestruj się</NavLink>
					</span>
				</button>
			}
			else
			{
				<button class="menu-button-img">
					<NavLink href="/usersettings"><img src="../images/sett.png" class="img-sett"></NavLink>
				</button>

				<button class="menu-button-img">
					<NavLink href="/inbox"><img src="../images/noti.png" class="img-noti"></NavLink>
				</button>

				<button class="menu-button-img">
					<NavLink href="/login"><img src="../images/user.png" class="img-user"></NavLink>
				</button>
			}
		</div>
	</div>
</nav>


@code {

	private UserStorageModel? usm;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			usm = await sessionStorage.GetUserAsync();

			StateHasChanged();
		}
	}


}