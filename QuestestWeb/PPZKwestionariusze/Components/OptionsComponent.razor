@using PPZKwestionariusze.Models
<div style="display:flex;padding:10px;padding-left:0px">
    <div style="flex:10">

        <div style="display:flex; align-items:center; gap:10px;">
            @if (CategoryId == 1)
            {
                <input type="checkbox"
                       style="width:40px; height:20px;"
                       @onclick="changeCorrect"
                       checked="@(Option.IsCorrect == "T")" />
            }
    

            <input class="form-control mb-1"
                   style="width:100%;"
                   placeholder="Odpowiedź..."
                   @bind="Option.Content" />
        </div>

    </div>

    <div style="flex:3">
        <button style="margin-right:30px;margin-left:30px"
                class="btn1"
                @onclick="Remove">
            Usuń
        </button>
    </div>
</div>

@code {
    [Parameter] public Option Option { get; set; } = new Option{Id=-1};
    [Parameter] public int CategoryId { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    private void changeCorrect()
    {
        if (Option.IsCorrect != "T")
        {
            Option.IsCorrect = "T";
            return;
        }
        Option.IsCorrect = "N";
    }
    private async Task Remove() => await OnRemove.InvokeAsync();
}
